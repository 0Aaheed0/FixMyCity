@model ErrorViewModel
@{
    ViewData["Title"] = "System Exception";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-5 text-center" style="max-width: 680px;">
    <div class="card border rounded-4 shadow-sm p-4 p-md-5 my-4">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger p-4" style="width: 88px; height: 88px; font-size: 42px;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <span class="fmc-status-dot bg-danger"></span>
            <span style="color: var(--color-danger); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">
                SYSTEM EXCEPTION &bull; 500
            </span>
        </div>

        <h1 class="display-6 fw-bold mb-2">Something Went Wrong</h1>
        <p class="text-muted fs-6 mb-4" style="line-height: 1.6;">
            An unexpected error occurred while processing your municipal request. The incident has been recorded for our engineering team.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="alert alert-light border d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 mb-4 font-monospace small">
                <i class="bi bi-fingerprint text-muted"></i>
                <span class="text-muted">Incident Reference:</span>
                <strong>@Model.RequestId</strong>
            </div>
        }

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button onclick="window.location.reload()" class="btn btn-primary px-4">
                <i class="bi bi-arrow-clockwise me-1"></i> Try Again
            </button>
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary px-4">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                <i class="bi bi-house me-1"></i> Home
            </a>
        </div>

        <div class="border-top pt-3 text-muted small">
            If this issue persists, please notify the civic technical helpdesk at <code>support@fixmycity.gov.bd</code>.
        </div>
    </div>
</div>
