<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FixMyCity</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FixMyCity.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="fmc-navbar">
            <a class="fmc-logo text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="fmc-logo-mark">+</span>
                FIX<span>MY</span>CITY
            </a>

            <div class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="fmc-nav-button text-decoration-none" asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                }
                else
                {
                    <a class="fmc-nav-button text-decoration-none" asp-area="Identity" asp-page="/Account/Login">
                        Log In
                    </a>
                    <a class="fmc-cta text-decoration-none d-inline-flex align-items-center justify-content-center px-3 py-2" style="font-size: 14px; min-height: 38px;" asp-area="Identity" asp-page="/Account/Register">
                        Sign Up
                    </a>
                }
            </div>
        </nav>
    </header>
    <div class="container fmc-page">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 mt-auto text-center" style="border-top: 1px solid rgba(255, 255, 255, 0.06); font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #555d66;">
        <div>
            &copy; 2026 FIXMYCITY &mdash; CIVIC REPORTING SYSTEM
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>