@using FixMyCity.Data
@using Microsoft.EntityFrameworkCore
@inject FixMyCityDbContext LayoutDbContext
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FixMyCity Smart Municipal Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var now = DateTime.UtcNow;
        var liveEmergency = await LayoutDbContext.EmergencyAlerts.Where(e => e.Status == "Active" && e.ExpireAt >= now).OrderByDescending(e => e.StartAt).FirstOrDefaultAsync();
    }

    <!-- Sticky City-wide Emergency Alert Bar -->
    @if (liveEmergency != null)
    {
        <div class="fmc-global-emergency-bar d-print-none py-2 px-3 text-white d-flex align-items-center justify-content-between">
            <div class="container d-flex align-items-center gap-3">
                <span class="badge bg-white text-danger fw-bold text-uppercase px-2 py-1">
                    <i class="bi bi-shield-exclamation me-1"></i> @liveEmergency.Severity EMERGENCY
                </span>
                <span class="fw-semibold text-truncate" style="max-width: 820px;">
                    @liveEmergency.Title &mdash; @liveEmergency.Description
                </span>
            </div>
            <a asp-controller="Community" asp-action="Alerts" class="btn btn-sm btn-light text-danger fw-bold text-nowrap flex-shrink-0">
                View Directive &rarr;
            </a>
        </div>
    }

    <!-- Clean Modern Public Header -->
    <header>
        <nav class="fmc-navbar px-3 px-md-4">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="fmc-brand-logo text-decoration-none d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="fmc-logo-badge"><i class="bi bi-buildings"></i></span>
                    <span class="fw-bold tracking-tight text-white fs-4">FIX<span class="text-primary-accent">MY</span>CITY</span>
                </a>

                <div class="d-none d-lg-flex align-items-center gap-4">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white-50 hover-text-white fw-semibold">Home</a>
                    <a asp-controller="Map" asp-action="Index" class="nav-link text-white-50 hover-text-white fw-semibold">Problem Map</a>
                    <a asp-controller="Gateway" asp-action="Index" class="nav-link text-white-50 hover-text-white fw-semibold">Municipal Gateway</a>
                    <a asp-controller="Community" asp-action="Announcements" class="nav-link text-white-50 hover-text-white fw-semibold">Announcements</a>
                    <a asp-controller="Community" asp-action="LostFound" class="nav-link text-white-50 hover-text-white fw-semibold">Lost & Found</a>
                </div>

                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <!-- Theme Toggle -->
                    <button id="themeToggleBtnHero" type="button" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Toggle Light/Dark Theme">
                        <i id="themeToggleIconHero" class="bi bi-moon-stars-fill"></i>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 fw-semibold" asp-controller="Home" asp-action="Dashboard">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Login">
                            Log In
                        </a>
                        <a class="btn btn-primary btn-sm px-3 fw-bold" asp-area="Identity" asp-page="/Account/Register">
                            Register
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="fmc-app-footer py-4 mt-auto border-top d-print-none">
        <div class="container small">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fmc-logo-badge" style="width: 28px; height: 28px; font-size: 14px;"><i class="bi bi-buildings"></i></span>
                    <span>&copy; 2026 <strong>FixMyCity Smart Municipal Portal</strong> &bull; Municipal Governance System</span>
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Map" asp-action="Index" class="text-muted text-decoration-none">Incident Map</a>
                    <a asp-controller="Gateway" asp-action="Index" class="text-muted text-decoration-none">Utility Gateway</a>
                    <a asp-controller="Community" asp-action="Alerts" class="text-muted text-decoration-none">Emergency Alerts</a>
                    <a asp-controller="Community" asp-action="LostFound" class="text-muted text-decoration-none">Lost & Found</a>
                    <a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">About</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function() {
            const themeBtn = document.getElementById('themeToggleBtnHero');
            const themeIcon = document.getElementById('themeToggleIconHero');

            function applyTheme(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('fmc-theme', theme);
                if (theme === 'dark') {
                    if (themeIcon) themeIcon.className = 'bi bi-sun-fill text-warning';
                } else {
                    if (themeIcon) themeIcon.className = 'bi bi-moon-stars-fill';
                }
            }

            const savedTheme = localStorage.getItem('fmc-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            applyTheme(savedTheme);

            if (themeBtn) {
                themeBtn.addEventListener('click', function() {
                    const current = document.documentElement.getAttribute('data-theme') || 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark');
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
