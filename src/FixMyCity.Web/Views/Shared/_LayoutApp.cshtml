<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FixMyCity</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <nav class="fmc-topbar">
        <div class="container-fluid d-flex align-items-center">
            <button class="fmc-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#fmcSidebar" aria-controls="fmcSidebar">
                <span></span><span></span><span></span>
            </button>
            <a class="fmc-brand-center" asp-controller="Home" asp-action="Dashboard">FIXMYCITY</a>
        </div>
    </nav>

    <div class="offcanvas offcanvas-start fmc-sidebar" tabindex="-1" id="fmcSidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fmc-brand">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close" style="filter: invert(1);"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="fmc-sidebar-nav">
                <li><a asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                <li><a asp-controller="Reports" asp-action="Index"><i class="bi bi-flag me-2"></i>Report an Issue</a></li>
                <li><a asp-controller="Reports" asp-action="MyReports"><i class="bi bi-list-check me-2"></i>My Reports</a></li>
                <li><a asp-controller="Map" asp-action="Index"><i class="bi bi-map me-2"></i>Problem Map</a></li>
                <li><a asp-controller="Staff" asp-action="Index"><i class="bi bi-tools me-2"></i>Staff Dashboard</a></li>
                <li><a asp-controller="Manager" asp-action="Index"><i class="bi bi-people me-2"></i>Manager Dashboard</a></li>
                <li><a asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer me-2"></i>Admin Dashboard</a></li>
                <li><a asp-controller="Admin" asp-action="Users"><i class="bi bi-person-gear me-2"></i>Manage Users</a></li>
                <li><a asp-controller="Admin" asp-action="Departments"><i class="bi bi-building me-2"></i>Manage Departments</a></li>
                <li><a asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags me-2"></i>Manage Categories</a></li>
                <li><a asp-controller="Admin" asp-action="Analytics"><i class="bi bi-graph-up me-2"></i>Hotspot Analytics</a></li>
                <li><a asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-2"></i>About</a></li>
                <li><a asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>Profile</a></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                        <button type="submit" class="fmc-sidebar-logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>

    <main class="fmc-app-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>