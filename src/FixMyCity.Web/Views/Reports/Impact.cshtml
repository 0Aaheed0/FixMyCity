@{ ViewData["Title"] = "My Civic Impact"; }
<div class="container py-4"><div class="fmc-dashboard-hero mb-4"><span class="fmc-dashboard-kicker"><i class="bi bi-stars"></i> YOUR CIVIC IMPACT</span><h2>See the change you helped create</h2><p>Every accurate report helps the city discover problems sooner and respond better.</p></div><div class="row g-4"><div class="col-md-3"><div class="fmc-stat-card fmc-admin-stat"><i class="bi bi-award-fill"></i><span>IMPACT SCORE</span><strong>@ViewBag.Score</strong></div></div><div class="col-md-3"><div class="fmc-stat-card fmc-admin-stat"><i class="bi bi-send-fill"></i><span>YOUR REPORTS</span><strong>@ViewBag.Total</strong></div></div><div class="col-md-3"><div class="fmc-stat-card fmc-admin-stat"><i class="bi bi-check2-circle"></i><span>RESOLVED</span><strong>@ViewBag.Resolved</strong></div></div><div class="col-md-3"><div class="fmc-stat-card fmc-admin-stat"><i class="bi bi-people-fill"></i><span>COMMUNITY REACH</span><strong>@ViewBag.CommunityReach</strong></div></div></div><div class="fmc-app-card p-4 mt-4"><h4>Your contribution matters</h4><p class="mb-0">Your score combines reports submitted, verified improvements, and supporting reports connected to the issues you helped identify.</p></div></div>
