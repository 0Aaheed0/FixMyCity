@model IEnumerable<FixMyCity.Data.Models.Report>
@{
    ViewData["Title"] = "All Reports";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- Top Action Bar -->
    <div class="fmc-dashboard-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="fmc-dashboard-kicker">
                    <i class="bi bi-broadcast"></i> PUBLIC INCIDENT LOG
                </span>
                <h1 class="fmc-card-title mb-1">COMMUNITY <span>REPORTS</span></h1>
                <p class="fmc-card-subtitle">
                    Live civic problem registry across all city wards. View public reports, resolution progress, and local fixes.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-plus-lg"></i> Report New Issue
                </a>
                <a asp-controller="Map" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-map"></i> View on Map
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Filter Card -->
    <div class="card border rounded-3 p-3 mb-4 shadow-sm">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-body border-end-0"><i class="bi bi-tag"></i></span>
                <select name="categoryId" class="form-select border-start-0">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var c in (IEnumerable<FixMyCity.Data.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@c.Id" selected="@(ViewBag.SelectedCategory == c.Id)">@c.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="input-group" style="max-width: 220px;">
                <span class="input-group-text bg-body border-end-0"><i class="bi bi-filter"></i></span>
                <select name="status" class="form-select border-start-0">
                    <option value="">All Statuses</option>
                    <option value="Reported">Reported</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                    <option value="Verified">Verified</option>
                </select>
            </div>

            <button class="btn btn-primary" type="submit">Filter Reports</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </form>
    </div>

    <!-- Reports Table Card -->
    @if (!Model.Any())
    {
        <div class="card border rounded-3 shadow-sm py-5 px-4 text-center">
            <div class="fmc-empty-state">
                <i class="bi bi-clipboard2-check text-muted"></i>
                <h4>No reports match your criteria</h4>
                <p>There are currently no civic incidents matching the selected filters. Be the first to report an issue in your area.</p>
                <a asp-action="Create" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-plus-lg me-1"></i> Submit First Report
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border rounded-3 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Reported By</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 1; }
                        @foreach (var item in Model)
                        {
                            var status = item.Issue?.Status ?? "Reported";
                            <tr>
                                <td class="ps-4 text-muted small" style="font-family: var(--font-mono);">@idx</td>
                                <td>
                                    <span class="badge bg-body-secondary text-body border">
                                        @(item.Category?.Name ?? "General")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                                        {
                                            <i class="bi bi-image text-primary" title="Photo evidence attached"></i>
                                        }
                                        <a asp-action="Verify" asp-route-id="@item.Id" class="fw-semibold text-body text-decoration-none">
                                            @item.Description
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    @if (status == "Verified")
                                    {
                                        <span class="badge badge-verified"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
                                    }
                                    else if (status == "Resolved")
                                    {
                                        <span class="badge badge-resolved"><i class="bi bi-check-circle-fill me-1"></i> Resolved</span>
                                    }
                                    else if (status == "InProgress")
                                    {
                                        <span class="badge badge-in-progress"><i class="bi bi-tools me-1"></i> In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-reported"><i class="bi bi-hourglass-split me-1"></i> Reported</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(item.User?.FullName ?? "Community Member")
                                </td>
                                <td class="text-muted small" style="font-family: var(--font-mono);">
                                    @item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Verify" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                        <span>Details</span> <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
