@model FixMyCity.Data.Models.Report
@{
    ViewData["Title"] = "Report an Issue";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-4" style="max-width: 820px;">

    <!-- Breadcrumb / Back Link -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 13px; font-family: 'JetBrains Mono', monospace;">
            <i class="bi bi-arrow-left me-1"></i> BACK TO REPORTS
        </a>
    </div>

    <!-- Main Card Container -->
    <div class="fmc-app-card">

        <!-- Card Header -->
        <div class="fmc-card-header-styled">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fmc-status-dot"></span>
                <span style="color: #ff7518; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase;">
                    CIVIC REPORTING, FIXED
                </span>
            </div>

            <h1 class="fmc-card-title">
                REPORT AN <span>ISSUE</span>
            </h1>

            <p class="fmc-card-subtitle">
                Spot a problem in your neighborhood? Provide details below and we will route it to the responsible department.
            </p>
        </div>

        <!-- Card Body -->
        <div class="fmc-card-body-styled">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert" style="background: rgba(255, 107, 95, 0.12); border: 1px solid #ff6b5f; color: #ff9b93;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert" style="background: rgba(255, 107, 95, 0.12); border: 1px solid #ff6b5f; color: #ff9b93;"></div>

                <!-- 1. Category -->
                <div class="fmc-form-group">
                    <label asp-for="CategoryId" class="fmc-form-label">
                        <i class="bi bi-tag-fill me-1 text-warning"></i> Issue Category <span class="req">*</span>
                    </label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="fmc-select form-select" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger mt-1 d-block" style="font-size: 12px;"></span>
                </div>

                <!-- 2. Description -->
                <div class="fmc-form-group">
                    <label asp-for="Description" class="fmc-form-label">
                        <i class="bi bi-chat-left-text-fill me-1 text-warning"></i> Problem Description <span class="req">*</span>
                    </label>
                    <textarea asp-for="Description"
                              class="fmc-textarea"
                              rows="4"
                              placeholder="Describe the issue in detail (e.g. Deep pothole causing hazard near Main St. & 5th Ave intersection)..."
                              required></textarea>
                    <span asp-validation-for="Description" class="text-danger mt-1 d-block" style="font-size: 12px;"></span>
                </div>

                <!-- 3. Location -->
                <div class="fmc-form-group">
                    <label class="fmc-form-label">
                        <i class="bi bi-geo-alt-fill me-1 text-warning"></i> Incident Location <span class="req">*</span>
                    </label>

                    <div class="fmc-location-box">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <span style="font-size: 13px; color: #858d95;">
                                Enter coordinates or auto-detect using GPS:
                            </span>
                            <button type="button" id="btnDetectLocation" class="fmc-location-btn">
                                <i class="bi bi-crosshair me-1"></i> Detect My Location
                            </button>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label text-muted" style="font-size: 12px;">Latitude</label>
                                <input asp-for="Latitude" id="txtLatitude" class="fmc-input" type="number" step="any" placeholder="e.g. 23.8103" required />
                                <span asp-validation-for="Latitude" class="text-danger mt-1 d-block" style="font-size: 12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label text-muted" style="font-size: 12px;">Longitude</label>
                                <input asp-for="Longitude" id="txtLongitude" class="fmc-input" type="number" step="any" placeholder="e.g. 90.4125" required />
                                <span asp-validation-for="Longitude" class="text-danger mt-1 d-block" style="font-size: 12px;"></span>
                            </div>
                        </div>

                        <div id="locationStatus" class="mt-2 text-warning" style="font-size: 12px; display: none;"></div>
                    </div>
                </div>

                <!-- 4. Photo Evidence (Optional) -->
                <div class="fmc-form-group">
                    <label class="fmc-form-label">
                        <i class="bi bi-camera-fill me-1 text-warning"></i> Upload Photo (Optional)
                    </label>

                    <div class="fmc-upload-box" onclick="document.getElementById('photoFileInput').click()">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <p class="fmc-upload-text">
                            <span>Click to browse</span> or take a photo
                        </p>
                        <small class="text-muted" style="font-size: 11px;">Supports JPG, PNG, WEBP</small>
                        <input type="file" id="photoFileInput" name="photo" accept="image/*" style="display: none;" onchange="previewImage(this)" />
                    </div>

                    <div id="imagePreviewContainer" class="mt-3 text-center" style="display: none;">
                        <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded border" style="max-height: 220px; border-color: rgba(255,117,24,0.4) !important;" />
                        <div class="mt-1">
                            <button type="button" class="btn btn-sm text-danger" onclick="clearImagePreview()">
                                <i class="bi bi-trash"></i> Remove image
                            </button>
                        </div>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated != true && ViewBag.UserId != null)
                {
                    <!-- Reporter Selection for Admin / Staff / Demo mode -->
                    <div class="fmc-form-group">
                        <label asp-for="UserId" class="fmc-form-label">
                            <i class="bi bi-person-badge-fill me-1 text-warning"></i> Report On Behalf Of
                        </label>
                        <select asp-for="UserId" asp-items="ViewBag.UserId" class="fmc-select form-select">
                            <option value="">-- Select User (or leave default) --</option>
                        </select>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap gap-3 pt-3 mt-4 border-top" style="border-top-color: rgba(255, 255, 255, 0.08) !important;">
                    <button type="submit" class="fmc-btn-submit">
                        <i class="bi bi-send-fill"></i> SUBMIT REPORT
                    </button>
                    <a asp-action="Index" class="fmc-btn-outline-cancel">
                        CANCEL
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Geolocation Detector
        document.getElementById('btnDetectLocation').addEventListener('click', function () {
            const status = document.getElementById('locationStatus');
            const latInput = document.getElementById('txtLatitude');
            const lngInput = document.getElementById('txtLongitude');

            if (!navigator.geolocation) {
                status.style.display = 'block';
                status.textContent = 'Geolocation is not supported by your browser.';
                return;
            }

            status.style.display = 'block';
            status.textContent = 'Acquiring GPS location...';

            navigator.geolocation.getCurrentPosition(
                function (position) {
                    latInput.value = position.coords.latitude.toFixed(6);
                    lngInput.value = position.coords.longitude.toFixed(6);
                    status.textContent = 'Location acquired: ' + position.coords.latitude.toFixed(4) + ', ' + position.coords.longitude.toFixed(4);
                    status.className = 'mt-2 text-success';
                },
                function (error) {
                    status.textContent = 'Could not retrieve location. Please type manually.';
                    status.className = 'mt-2 text-warning';
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        });

        // Photo Preview
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imagePreview');
                    img.src = e.target.result;
                    document.getElementById('imagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearImagePreview() {
            const input = document.getElementById('photoFileInput');
            input.value = '';
            document.getElementById('imagePreviewContainer').style.display = 'none';
        }
    </script>
}