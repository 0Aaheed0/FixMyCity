@model FixMyCity.Data.Models.Report
@{
    ViewData["Title"] = "Verify Resolution";
}
<div class="fmc-dashboard-hero">
    <h2>Verify Resolution</h2>
    <p><strong>@Model.Description</strong></p>
    <p>Category: @Model.Category?.Name</p>
    <p>Status: @(Model.Issue?.Status ?? "Not yet grouped into an issue")</p>
    <p>Accept/Reject buttons and before/after photo comparison go here.</p>
</div>