@model IEnumerable<FixMyCity.Data.Models.StatusHistory>
@{
    ViewData["Title"] = "Report Status History";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-4" style="max-width: 920px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="MyReports" class="text-decoration-none text-muted" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> BACK TO MY REPORTS
        </a>
    </div>

    <!-- Header -->
    <div class="fmc-dashboard-hero mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="fmc-status-dot"></span>
            <span style="color: var(--color-primary); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">
                LIFECYCLE AUDIT TRAIL
            </span>
        </div>
        <h1 class="fmc-card-title mb-1">
            REPORT <span>STATUS UPDATES</span>
        </h1>
        <p class="fmc-card-subtitle">
            Follow every state progression, technician assignment, and resolution note across your submitted civic issues.
        </p>
    </div>

    <!-- Status History Card -->
    <div class="card border rounded-3 shadow-sm p-4">
        @if (!Model.Any())
        {
            <div class="fmc-empty-state">
                <i class="bi bi-clock-history"></i>
                <h4>No Status Updates Yet</h4>
                <p>Status transitions and notes from municipal staff will appear here as your reports progress.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Submit a Report
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var update in Model)
                {
                    <div class="card border rounded-3 p-3 bg-light d-flex flex-row align-items-start gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; font-size: 18px;">
                            <i class="bi bi-arrow-up-right-circle-fill"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                <span class="fw-bold">
                                    Issue #@update.IssueId transitioned to
                                    <span class="badge bg-primary ms-1">@update.NewStatus</span>
                                </span>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i> @update.ChangedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(update.Note))
                            {
                                <p class="text-muted small mb-0 mt-1">@update.Note</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
