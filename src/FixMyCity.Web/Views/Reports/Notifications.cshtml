@model IEnumerable<FixMyCity.Data.Models.StatusHistory>
@{ ViewData["Title"] = "Notifications"; }
<div class="container py-4"><div class="fmc-dashboard-hero mb-4"><span class="fmc-dashboard-kicker"><i class="bi bi-bell-fill"></i> COMMUNITY UPDATES</span><h2>Your notifications</h2><p>Follow every change to the reports you submitted.</p></div><div class="fmc-app-card p-4">@if (!Model.Any()) { <p>No status updates yet. New updates will appear here automatically.</p> } else { @foreach (var update in Model) { <div class="fmc-notification-item"><i class="bi bi-arrow-up-right-circle-fill"></i><div><strong>Issue #@update.IssueId moved to @update.NewStatus</strong><small>@update.Note · @update.ChangedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</small></div></div> } }</div></div>
