@model FixMyCity.Web.Models.GatewayDashboardViewModel
@{
    ViewData["Title"] = "Municipal Gateway";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-4" style="max-width: 1200px;">
    <!-- Hero / Title -->
    <div class="fmc-dashboard-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fmc-status-dot"></span>
                    <span style="color: var(--color-primary); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">
                        SECURE CITIZEN GATEWAY
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 11px;">
                        <i class="bi bi-shield-lock me-1"></i> SSL 256-BIT ENCRYPTED
                    </span>
                </div>
                <h1 class="fmc-card-title mb-1">
                    ONLINE <span>MUNICIPAL GATEWAY</span>
                </h1>
                <p class="fmc-card-subtitle">
                    Pay utility and civic bills digitally for Dhaka & beyond &mdash; DPDC, DESCO, Titas Gas, WASA & Holding Tax.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Lookup" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-search"></i> Search Any Bill
                </a>
                <a asp-action="History" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-clock-history"></i> Payment History
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stat Overview if Authenticated -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="fmc-stat-card border-start border-4 border-warning">
                    <div>
                        <div class="fmc-stat-label">Pending / Unpaid Bills</div>
                        <div class="fmc-stat-value text-warning">@Model.PendingBills.Count</div>
                        <small class="text-muted">Awaiting your payment</small>
                    </div>
                    <div class="fmc-stat-icon text-warning bg-warning-subtle">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="fmc-stat-card border-start border-4 border-success">
                    <div>
                        <div class="fmc-stat-label">Successful Payments</div>
                        <div class="fmc-stat-value text-success">@Model.TotalPaidCount</div>
                        <small class="text-muted">Verified digital transactions</small>
                    </div>
                    <div class="fmc-stat-icon text-success bg-success-subtle">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="fmc-stat-card border-start border-4 border-info">
                    <div>
                        <div class="fmc-stat-label">Total Amount Paid</div>
                        <div class="fmc-stat-value text-info">BDT @Model.TotalPaidAmount.ToString("N0")</div>
                        <small class="text-muted">Direct to municipal treasury</small>
                    </div>
                    <div class="fmc-stat-icon text-info bg-info-subtle">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Municipal Services Grid -->
    <div class="mb-4">
        <h4 class="mb-3 d-flex align-items-center gap-2 text-primary-emphasis" style="font-weight: 700;">
            <i class="bi bi-grid-3x3-gap-fill text-primary"></i> Municipal & Utility Services
        </h4>

        <div class="row g-3">
            @foreach (var s in Model.Services)
            {
                var icon = "bi-building";
                var colorClass = "primary";
                if (s.Category == "Electricity") { icon = "bi-lightning-charge-fill"; colorClass = "warning"; }
                else if (s.Category == "Gas") { icon = "bi-fire"; colorClass = "danger"; }
                else if (s.Category == "Water") { icon = "bi-droplet-fill"; colorClass = "info"; }
                else if (s.Category == "Tax") { icon = "bi-bank2"; colorClass = "success"; }
                else if (s.Category == "Waste") { icon = "bi-trash3-fill"; colorClass = "secondary"; }

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border rounded-3 shadow-sm hover-shadow transition-all fmc-gateway-card">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-3 p-3 text-@colorClass bg-@colorClass-subtle d-inline-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-size: 24px;">
                                    <i class="bi @icon"></i>
                                </div>
                                <div>
                                    <h5 class="card-title mb-0 fw-bold">@s.Name</h5>
                                    <small class="text-muted">@s.Category</small>
                                </div>
                            </div>

                            <p class="card-text text-muted mb-3" style="font-size: 13.5px; min-height: 40px;">
                                @s.Description
                            </p>

                            <div class="mb-3">
                                <small class="text-uppercase text-muted fw-semibold" style="font-size: 11px; letter-spacing: 1px;">Supported Providers:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var p in s.Providers.Where(pr => pr.IsActive))
                                    {
                                        <a asp-action="Lookup" asp-route-providerId="@p.Id" class="badge bg-light text-dark border text-decoration-none py-1 px-2" title="Pay with @p.Name">
                                            @p.Name
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="d-grid mt-auto">
                                <a asp-action="Lookup" asp-route-serviceId="@s.Id" class="btn btn-outline-primary btn-sm d-flex justify-content-between align-items-center">
                                    <span>Select Service</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 2 Column Section: Pending Bills + Recent Transactions -->
    <div class="row g-4">
        <!-- Pending Bills -->
        <div class="col-lg-6">
            <div class="card h-100 border rounded-3 shadow-sm">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-warning"></i> Due Bills
                    </h5>
                    <a asp-action="Lookup" class="btn btn-sm btn-link text-decoration-none p-0">+ Add / Find Bill</a>
                </div>
                <div class="card-body p-3">
                    @if (!Model.PendingBills.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle text-success" style="font-size: 40px;"></i>
                            <h6 class="mt-2 fw-semibold">No Pending Bills Found</h6>
                            <p class="small mb-3">You have cleared all municipal utility dues or haven't looked up a bill yet.</p>
                            <a asp-action="Lookup" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Look Up & Pay a Bill
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var bill in Model.PendingBills)
                            {
                                <div class="list-group-item px-2 py-3 border-bottom d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle p-2 bg-light border text-primary" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-receipt"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@bill.Provider?.Name</div>
                                            <div class="small text-muted">Acc: <code>@bill.ConsumerNumber</code> &bull; Period: @bill.BillingPeriod</div>
                                            <div class="small text-danger fw-semibold">
                                                <i class="bi bi-calendar-event me-1"></i> Due: @bill.DueDate.ToString("MMM dd, yyyy")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-primary fs-5">BDT @bill.Amount.ToString("N2")</div>
                                        <a asp-action="Pay" asp-route-billId="@bill.Id" class="btn btn-sm btn-primary mt-1 px-3">
                                            Pay Now
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="col-lg-6">
            <div class="card h-100 border rounded-3 shadow-sm">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-journal-check text-success"></i> Recent Payments
                    </h5>
                    <a asp-action="History" class="btn btn-sm btn-link text-decoration-none p-0">View All</a>
                </div>
                <div class="card-body p-3">
                    @if (!Model.RecentTransactions.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-credit-card text-muted" style="font-size: 40px;"></i>
                            <h6 class="mt-2 fw-semibold">No Payment History Yet</h6>
                            <p class="small mb-0">Payments completed online will generate instant official municipal receipts here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var txn in Model.RecentTransactions)
                            {
                                <div class="list-group-item px-2 py-3 border-bottom d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(txn.Status == "Success" ? "bg-success" : "bg-danger")">
                                                @txn.Status
                                            </span>
                                            <span class="fw-semibold">@txn.Bill?.Provider?.Name</span>
                                            <span class="badge bg-light text-dark border">@txn.PaymentMethod</span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Ref: <code>@txn.TransactionReference</code> &bull; @((txn.PaidAt ?? txn.CreatedAt).ToLocalTime().ToString("MMM dd, yyyy hh:mm tt"))
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold">BDT @txn.Amount.ToString("N2")</div>
                                        <a asp-action="Receipt" asp-route-transactionId="@txn.Id" class="btn btn-sm btn-outline-secondary mt-1">
                                            <i class="bi bi-file-earmark-text"></i> Receipt
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
