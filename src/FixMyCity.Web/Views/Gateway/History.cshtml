@model IEnumerable<FixMyCity.Data.Models.PaymentTransaction>
@{
    ViewData["Title"] = "Payment History - Municipal Gateway";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-4" style="max-width: 1100px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> BACK TO GATEWAY
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">MUNICIPAL <span>PAYMENT HISTORY</span></h2>
            <p class="text-muted small mb-0">Record of all utility and civic bills processed through FixMyCity.</p>
        </div>
        <a asp-action="Lookup" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-search"></i> Pay New Bill
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border rounded-3 p-5 text-center shadow-sm">
            <div class="mb-3">
                <i class="bi bi-receipt-cutoff text-muted" style="font-size: 48px;"></i>
            </div>
            <h4 class="fw-bold">No Payment Transactions Recorded</h4>
            <p class="text-muted mx-auto" style="max-width: 480px;">
                You haven't completed any bill payments yet. Look up your electricity, gas, water or municipal tax bill to make a secure digital payment.
            </p>
            <div class="mt-2">
                <a asp-action="Lookup" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i> Look Up & Pay a Bill
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border rounded-3 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 px-3">Transaction Ref</th>
                            <th scope="col" class="py-3">Provider & Service</th>
                            <th scope="col" class="py-3">Consumer No</th>
                            <th scope="col" class="py-3">Period</th>
                            <th scope="col" class="py-3">Channel</th>
                            <th scope="col" class="py-3 text-end">Amount</th>
                            <th scope="col" class="py-3 text-center">Status</th>
                            <th scope="col" class="py-3 text-end px-3">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model)
                        {
                            <tr>
                                <td class="px-3">
                                    <span class="font-monospace fw-semibold text-primary">@txn.TransactionReference</span>
                                    <div class="text-muted small" style="font-size: 11px;">
                                        @((txn.PaidAt ?? txn.CreatedAt).ToLocalTime().ToString("MMM dd, yyyy HH:mm"))
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@txn.Bill?.Provider?.Name</div>
                                    <small class="text-muted">@txn.Bill?.Provider?.Service?.Name</small>
                                </td>
                                <td class="font-monospace">@txn.Bill?.ConsumerNumber</td>
                                <td>@txn.Bill?.BillingPeriod</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@txn.PaymentMethod</span>
                                </td>
                                <td class="text-end fw-bold">
                                    BDT @txn.Amount.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge @(txn.Status == "Success" ? "bg-success" : "bg-danger") px-2 py-1">
                                        @txn.Status
                                    </span>
                                </td>
                                <td class="text-end px-3">
                                    <a asp-action="Receipt" asp-route-transactionId="@txn.Id" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-file-earmark-text"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
