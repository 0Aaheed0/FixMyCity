@model IEnumerable<FixMyCity.Data.Models.Issue>
@{
    ViewData["Title"] = "Field Response Operations";
    Layout = "_LayoutApp";
    var radar = ViewBag.PriorityRadar as FixMyCity.Data.Models.Issue;
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- Field Staff Hero -->
    <div class="fmc-dashboard-hero mb-4">
        <span class="fmc-dashboard-kicker">
            <i class="bi bi-tools"></i> FIELD RESPONSE WORKSPACE
        </span>
        <h1 class="fmc-card-title mb-1">FIELD CREW <span>OPERATIONS</span></h1>
        <p class="fmc-card-subtitle">
            Inspect assigned municipal problems, execute repairs, update resolution status, and attach photographic verification evidence.
        </p>
    </div>

    <!-- Priority Radar -->
    @if (radar != null)
    {
        <div class="fmc-priority-radar mb-4">
            <i class="bi bi-broadcast-pin"></i>
            <div>
                <strong>Civic Priority Radar &bull; High Dispatch Urgency</strong>
                <span>
                    <strong>@(radar.Category?.Name ?? "Incident")</strong> requires immediate response &bull; Priority Score: <strong>@radar.PriorityScore</strong> &bull; <strong>@(radar.Reports.Count)</strong> supporting citizen reports.
                </span>
            </div>
        </div>
    }

    <!-- Issues Table Card -->
    <div class="card border rounded-3 shadow-sm overflow-hidden mb-4">
        <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Assigned Work Queue</h5>
            <span class="badge bg-body-secondary text-body border">@Model.Count() Incidents</span>
        </div>

        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success opacity-75"></i>
                <h5>All caught up!</h5>
                <p class="small mb-0">No pending municipal repair tasks are currently assigned to your team.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Issue #</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Reports</th>
                            <th>Current Status & Update</th>
                            <th class="text-end pe-4">Resolution Proof</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small" style="font-family: var(--font-mono);">
                                    #@i.Id
                                </td>
                                <td>
                                    <span class="fw-semibold text-body">
                                        @(i.Category?.Name ?? "General Civic Issue")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(i.PriorityScore >= 5 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-warning-subtle text-warning border border-warning-subtle")">
                                        Priority @i.PriorityScore
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-body-secondary text-body border">
                                        <i class="bi bi-people me-1"></i> @i.Reports.Count
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <select name="status" class="form-select form-select-sm" style="min-width: 140px;">
                                            <option value="InProgress" selected="@(i.Status == "InProgress")">In Progress</option>
                                            <option value="Resolved" selected="@(i.Status == "Resolved")">Resolved</option>
                                            <option value="Verified" selected="@(i.Status == "Verified")">Verified</option>
                                        </select>
                                        <button class="btn btn-sm btn-primary" type="submit">Save</button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Evidence" asp-route-id="@i.Id" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-camera-fill"></i> Upload Proof
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
