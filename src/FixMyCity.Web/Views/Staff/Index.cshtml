@model IEnumerable<FixMyCity.Data.Models.Issue>
@{
    ViewData["Title"] = "Staff Dashboard";
}
<div class="fmc-dashboard-hero">
    <h2>Staff Dashboard</h2>
    <table class="table mt-3">
        <thead><tr><th>Category</th><th>Priority</th><th>Status</th><th>Reports</th><th></th></tr></thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Category?.Name</td>
                    <td>@i.PriorityScore</td>
                    <td>@i.Status</td>
                    <td>@i.Reports.Count</td>
                    <td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@i.Id" /><select name="status" class="form-select form-select-sm"><option>InProgress</option><option>Resolved</option><option>Verified</option></select><button class="btn btn-sm btn-primary">Save</button></form><a asp-controller="Staff" asp-action="Evidence" asp-route-id="@i.Id">Upload Evidence</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
