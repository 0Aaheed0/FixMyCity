@{
    ViewData["Title"] = "Upload Evidence";
}
<div class="fmc-dashboard-hero">
    <h2>Upload Evidence</h2>
    <p>Issue #@ViewBag.IssueId - upload repair evidence for verification.</p>
    <form asp-action="Evidence" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@ViewBag.IssueId" /><input class="form-control mb-3" type="file" name="photo" accept="image/*" required /><textarea class="form-control mb-3" name="note" placeholder="Add a repair note..."></textarea><button class="btn btn-primary" type="submit">Upload evidence</button></form>
</div>
