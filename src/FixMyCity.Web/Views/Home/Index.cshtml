@{
    ViewData["Title"] = "Welcome";
    Layout = "_LayoutHero";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="fmc-landing">

    <!-- Navigation -->
    <nav class="fmc-navbar">
        <div class="fmc-logo">
            <span class="fmc-logo-mark">+</span>
            FIX<span>MY</span>CITY
        </div>

        <div>
            @if (isAuthenticated)
            {
                <a class="fmc-nav-button text-decoration-none" asp-controller="Home" asp-action="Dashboard">
                    Dashboard
                </a>
            }
            else
            {
                <button type="button"
                        class="fmc-nav-button"
                        data-bs-toggle="modal"
                        data-bs-target="#getStartedModal">
                    Get Started
                </button>
            }
        </div>
    </nav>


    <!-- Main Hero -->
    <main class="fmc-main">

        <div class="fmc-hero-content">

            <div class="fmc-eyebrow">
                <span class="fmc-status-dot"></span>
                CIVIC REPORTING, FIXED
            </div>

            <h1 class="fmc-headline">
                MAKE YOUR CITY
                <br />
                <span>BETTER.</span>
            </h1>

            <p class="fmc-subtext">
                Report problems in your community, track their progress,
                and help make your city cleaner, safer, and better.
            </p>

            <div class="fmc-actions">
                @if (isAuthenticated)
                {
                    <a class="fmc-cta text-decoration-none d-inline-flex align-items-center justify-content-center" asp-controller="Home" asp-action="Dashboard">
                        GET STARTED
                        <span>→</span>
                    </a>
                }
                else
                {
                    <button type="button"
                            class="fmc-cta"
                            data-bs-toggle="modal"
                            data-bs-target="#getStartedModal">
                        GET STARTED
                        <span>→</span>
                    </button>
                }
            </div>

        </div>


        <!-- Feature Cards -->
        <section class="fmc-features">

            <div class="fmc-feature-card">
                <div class="fmc-feature-number">01</div>

                <div>
                    <h3>REPORT</h3>
                    <p>
                        Spot a problem? Submit a report with location and category to notify the responsible department.
                    </p>
                </div>
            </div>


            <div class="fmc-feature-card">
                <div class="fmc-feature-number">02</div>

                <div>
                    <h3>TRACK</h3>
                    <p>
                        Follow your report status in real time as staff investigate and take action.
                    </p>
                </div>
            </div>


            <div class="fmc-feature-card">
                <div class="fmc-feature-number">03</div>

                <div>
                    <h3>FIX</h3>
                    <p>
                        Review completion evidence and watch reported issues turn into real community improvements.
                    </p>
                </div>
            </div>

        </section>

    </main>


    <!-- Bottom Stripe -->
    <div class="fmc-hazard-stripe"></div>

</div>

<!-- Get Started Modal (placed outside .fmc-landing to prevent overflow/backdrop clipping) -->
<div class="modal fade fmc-modal"
     id="getStartedModal"
     tabindex="-1"
     aria-labelledby="getStartedModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <div class="fmc-modal-label">
                        FIXMYCITY
                    </div>

                    <h5 class="modal-title" id="getStartedModalLabel">
                        Get Started
                    </h5>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <a class="fmc-choice"
                   asp-area="Identity"
                   asp-page="/Account/Login">

                    <span>
                        <i class="bi bi-box-arrow-in-right me-2 text-warning"></i> LOG IN
                        <small>
                            Already have an account — access your dashboard
                        </small>
                    </span>

                    <strong>→</strong>

                </a>


                <a class="fmc-choice"
                   asp-area="Identity"
                   asp-page="/Account/Register">

                    <span>
                        <i class="bi bi-person-plus me-2 text-warning"></i> SIGN UP
                        <small>
                            New here — create an account to start reporting
                        </small>
                    </span>

                    <strong>→</strong>

                </a>

            </div>

        </div>

    </div>

</div>
