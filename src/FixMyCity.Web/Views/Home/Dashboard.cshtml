@model FixMyCity.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Citizen Dashboard";
    Layout = "_LayoutApp";
    var resolutionRate = Model.TotalIssues > 0 ? (int)((double)Model.ResolvedIssues / Model.TotalIssues * 100) : (Model.TotalReports > 0 ? 100 : 0);
}

<div class="container-fluid py-4" style="max-width: 1280px;">

    <!-- 0. EMERGENCY ALERT TOP BANNER (FEATURE 3 & 13) -->
    @if (Model.ActiveAlerts.Any())
    {
        <div class="mb-4">
            @foreach (var alert in Model.ActiveAlerts)
            {
                <div class="alert alert-danger border-2 border-danger rounded-3 shadow p-4 d-flex flex-wrap align-items-center justify-content-between gap-3 animate__animated animate__headShake">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-danger text-white p-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px; font-size: 24px;">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-danger">⚠ EMERGENCY DIRECTIVE &bull; @alert.Severity.ToUpper()</span>
                                <small class="text-danger fw-semibold">Expires: @alert.ExpireAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</small>
                            </div>
                            <h3 class="h4 fw-bold text-danger-emphasis mb-1">@alert.Title</h3>
                            <p class="mb-0 text-body small" style="max-width: 780px;">@alert.Description</p>
                        </div>
                    </div>
                    <a asp-controller="Community" asp-action="Alerts" class="btn btn-danger btn-sm px-4 py-2 fw-bold shadow-sm">
                        View Details <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    }

    <!-- 1. Hero Header Banner -->
    <div class="fmc-dashboard-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fmc-status-dot"></span>
                    <span style="color: var(--color-primary); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">
                        MUNICIPAL CITIZEN PORTAL
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        SYSTEM OPERATIONAL
                    </span>
                </div>
                <h1 class="fmc-card-title mb-1">
                    WELCOME BACK, <span>@Model.UserFullName</span>
                </h1>
                <p class="fmc-card-subtitle">
                    Live civic monitoring, municipal gateway bills, local announcements & community assistance.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Reports" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-plus-lg"></i> Report Problem
                </a>
                <a asp-controller="Gateway" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-credit-card-2-front"></i> Pay Utility Bills
                </a>
            </div>
        </div>
    </div>

    <!-- 2. High-Impact Metric Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="fmc-stat-card border-start border-4 border-primary">
                <div>
                    <div class="fmc-stat-label">Total Reports Logged</div>
                    <div class="fmc-stat-value">@Model.TotalReports</div>
                    <small class="text-muted"><i class="bi bi-globe me-1"></i> Metropolitan-wide</small>
                </div>
                <div class="fmc-stat-icon text-primary bg-primary-subtle">
                    <i class="bi bi-flag-fill"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="fmc-stat-card border-start border-4 border-warning">
                <div>
                    <div class="fmc-stat-label">Pending / In Progress</div>
                    <div class="fmc-stat-value text-warning">@Model.PendingReports</div>
                    <small class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Active municipal repair</small>
                </div>
                <div class="fmc-stat-icon text-warning bg-warning-subtle">
                    <i class="bi bi-activity"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="fmc-stat-card border-start border-4 border-success">
                <div>
                    <div class="fmc-stat-label">Resolved & Fixed</div>
                    <div class="fmc-stat-value text-success">@Model.ResolvedIssues</div>
                    <small class="text-muted"><i class="bi bi-check-circle-fill text-success me-1"></i> Community improvements</small>
                </div>
                <div class="fmc-stat-icon text-success bg-success-subtle">
                    <i class="bi bi-check2-all"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="fmc-stat-card border-start border-4 border-info">
                <div>
                    <div class="fmc-stat-label">My Contributions</div>
                    <div class="fmc-stat-value text-info">@Model.MyReportsCount</div>
                    <small class="text-muted"><i class="bi bi-person-fill text-info me-1"></i> Your personal submissions</small>
                </div>
                <div class="fmc-stat-icon text-info bg-info-subtle">
                    <i class="bi bi-person-check-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Quick Action Command Hub -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <a asp-controller="Reports" asp-action="Create" class="card border rounded-3 p-3 text-decoration-none shadow-sm hover-shadow text-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-danger-subtle text-danger fs-4">
                        <i class="bi bi-exclamation-diamond-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Report Issue</div>
                        <small class="text-muted">Auto-GPS & photo</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Gateway" asp-action="Index" class="card border rounded-3 p-3 text-decoration-none shadow-sm hover-shadow text-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary fs-4">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Pay Bills</div>
                        <small class="text-muted">DPDC, Gas, WASA</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Community" asp-action="LostFound" class="card border rounded-3 p-3 text-decoration-none shadow-sm hover-shadow text-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success-subtle text-success fs-4">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Lost & Found</div>
                        <small class="text-muted">Community feed</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Map" asp-action="Index" class="card border rounded-3 p-3 text-decoration-none shadow-sm hover-shadow text-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info-subtle text-info fs-4">
                        <i class="bi bi-map-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Problem Map</div>
                        <small class="text-muted">Active incident radar</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 4. Main 2-Column Dashboard Layout -->
    <div class="row g-4">

        <!-- LEFT COLUMN: Live Reports Stream + Municipal Services (8 Cols) -->
        <div class="col-lg-8">

            <!-- Nearby Municipal Announcements if any -->
            @if (Model.NearbyAnnouncements.Any())
            {
                <div class="card border rounded-3 shadow-sm mb-4">
                    <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-megaphone-fill text-primary"></i> Municipal Notices Near You
                        </h5>
                        <a asp-controller="Community" asp-action="Announcements" class="small text-decoration-none">View All</a>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var a in Model.NearbyAnnouncements.Take(2))
                            {
                                <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@a.Category</span>
                                            <span class="fw-bold">@a.Title</span>
                                        </div>
                                        <small class="text-muted d-block mt-1">@a.Description</small>
                                    </div>
                                    <a asp-controller="Community" asp-action="AnnouncementDetails" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary ms-3 flex-shrink-0">
                                        Details
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Live Community Reports Stream -->
            <div class="card border rounded-3 shadow-sm mb-4">
                <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h4 class="h5 fw-bold mb-0 text-body">
                            <i class="bi bi-activity text-primary me-2"></i> LIVE COMMUNITY INCIDENTS
                        </h4>
                        <small class="text-muted">Real-time reports logged by residents</small>
                    </div>
                    <a asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        All Reports (@Model.TotalReports) <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="card-body p-4">
                    @if (!Model.RecentReports.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check text-success" style="font-size: 40px;"></i>
                            <h5 class="fw-bold mt-2">No Open Incidents</h5>
                            <p class="small mb-0">Your community area currently has a clean log.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var report in Model.RecentReports.Take(6))
                            {
                                var status = report.Issue?.Status ?? "Reported";
                                var statusBadge = status == "Resolved" || status == "Verified" ? "bg-success" :
                                                  status == "InProgress" ? "bg-primary" : "bg-warning text-dark";

                                <div class="p-3 bg-body-secondary rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        @if (!string.IsNullOrEmpty(report.PhotoPath))
                                        {
                                            <img src="@report.PhotoPath" alt="Photo" class="rounded border flex-shrink-0" style="width: 52px; height: 52px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-body border p-2 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px; font-size: 22px;">
                                                <i class="bi bi-flag-fill"></i>
                                            </div>
                                        }

                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-body text-body border">@report.Category?.Name</span>
                                                <span class="badge @statusBadge">@status</span>
                                                <small class="text-muted">@report.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                            </div>
                                            <div class="fw-semibold text-body small mb-1" style="max-width: 440px;">
                                                @report.Description
                                            </div>
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i> @(report.User?.FullName ?? "Citizen") &bull;
                                                <i class="bi bi-geo-alt me-1"></i> @report.Latitude.ToString("F3"), @report.Longitude.ToString("F3")
                                            </small>
                                        </div>
                                    </div>

                                    <a asp-controller="Reports" asp-action="Verify" asp-route-id="@report.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Lost & Found Items -->
            @if (Model.RecentLostFound.Any())
            {
                <div class="card border rounded-3 shadow-sm mb-4">
                    <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-success"></i> Recent Lost & Found Bulletins
                        </h5>
                        <a asp-controller="Community" asp-action="LostFound" class="small text-decoration-none">Community Feed</a>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            @foreach (var item in Model.RecentLostFound.Take(3))
                            {
                                var isLost = item.PostType == "Lost";
                                <div class="col-md-4">
                                    <div class="card h-100 border rounded-2 p-3 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @(isLost ? "bg-danger" : "bg-success")">
                                                @(isLost ? "LOST" : "FOUND")
                                            </span>
                                            <small class="text-muted">@item.Category</small>
                                        </div>
                                        <h6 class="fw-bold mb-1 text-truncate" title="@item.Title">@item.Title</h6>
                                        <small class="text-muted d-block text-truncate mb-2"><i class="bi bi-geo-alt text-danger me-1"></i>@item.LocationName</small>
                                        <div class="mt-auto pt-2 border-top text-end">
                                            <a asp-controller="Community" asp-action="LostFoundDetails" asp-route-id="@item.Id" class="btn btn-sm btn-link p-0 text-decoration-none">
                                                View & Respond &rarr;
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- RIGHT COLUMN: Utility Bills, Resolution Health & Notifications (4 Cols) -->
        <div class="col-lg-4 d-flex flex-column gap-4">

            <!-- 1. Pending Municipal Bills Widget -->
            <div class="card border rounded-3 shadow-sm">
                <div class="card-header bg-transparent py-3 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-receipt text-warning me-2"></i> Pending Utility Bills</h5>
                    <a asp-controller="Gateway" asp-action="Index" class="btn btn-sm btn-link p-0 text-decoration-none">Gateway</a>
                </div>
                <div class="p-3">
                    @if (!Model.PendingBills.Any())
                    {
                        <div class="text-center py-3 text-muted small">
                            <i class="bi bi-check-circle text-success fs-3"></i>
                            <div class="mt-1 fw-semibold">No Dues Pending</div>
                            <small>You're all settled up on utility bills.</small>
                            <div class="mt-2">
                                <a asp-controller="Gateway" asp-action="Lookup" class="btn btn-sm btn-outline-primary">Search a Bill</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var bill in Model.PendingBills.Take(3))
                            {
                                <div class="p-3 rounded-2 border bg-body-secondary d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-body small">@bill.Provider?.Name</div>
                                        <div class="text-muted font-monospace" style="font-size: 11px;">Acc: @bill.ConsumerNumber</div>
                                        <small class="text-danger fw-semibold">Due: @bill.DueDate.ToString("MMM dd")</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-primary">BDT @bill.Amount.ToString("N0")</div>
                                        <a asp-controller="Gateway" asp-action="Pay" asp-route-billId="@bill.Id" class="btn btn-sm btn-primary mt-1 px-3" style="font-size: 11px;">
                                            Pay
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 2. City Infrastructure Health / Resolution Rate -->
            <div class="card border rounded-3 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-bold text-primary text-uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 11px;">
                        MUNICIPAL RESOLUTION PROGRESS
                    </span>
                    <span class="fw-bold font-monospace fs-6">
                        @resolutionRate%
                    </span>
                </div>
                <div class="progress" style="height: 10px; border-radius: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @resolutionRate%;" aria-valuenow="@resolutionRate" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted d-block mt-2" style="font-size: 11px;">
                    @Model.ResolvedIssues of @(Model.TotalReports > 0 ? Model.TotalReports : Model.TotalIssues) problems successfully fixed.
                </small>
            </div>

            <!-- 3. Unread Notifications Snippet -->
            <div class="card border rounded-3 shadow-sm">
                <div class="card-header bg-transparent py-3 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-bell-fill text-primary me-2"></i> Recent Alerts</h5>
                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-link p-0 text-decoration-none">All</a>
                </div>
                <div class="p-3">
                    @if (!Model.UnreadNotifications.Any())
                    {
                        <div class="text-center py-3 text-muted small">
                            <i class="bi bi-bell-slash fs-4"></i>
                            <div class="mt-1">No unread notifications</div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var n in Model.UnreadNotifications.Take(4))
                            {
                                <div class="p-2 border-bottom">
                                    <div class="fw-bold small text-body">@n.Title</div>
                                    <p class="text-muted mb-1" style="font-size: 12px; line-height: 1.4;">@n.Message</p>
                                    <small class="text-muted" style="font-size: 10px;">@n.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Active Response Departments -->
            <div class="card border rounded-3 shadow-sm">
                <div class="card-header bg-transparent py-3 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-building-fill text-primary me-2"></i> Municipal Teams</h5>
                    <span class="badge bg-success" style="font-size: 9px;">ACTIVE</span>
                </div>
                <div class="p-3">
                    <div class="d-flex flex-column gap-2">
                        @foreach (var dep in Model.Departments.Take(4))
                        {
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-body-secondary">
                                <span class="small fw-semibold">@dep.Name</span>
                                <span class="badge bg-body text-body border">@dep.Categories.Count categories</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
