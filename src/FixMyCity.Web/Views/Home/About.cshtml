@{
    ViewData["Title"] = "About FixMyCity";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
}

<div class="container py-4" style="max-width: 1100px;">
    <!-- Hero / Eyebrow -->
    <div class="fmc-dashboard-hero mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="fmc-status-dot"></span>
            <span style="color: var(--color-primary); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">
                CIVIC TECHNOLOGY INITIATIVE
            </span>
        </div>
        <h1 class="fmc-card-title mb-2">
            ABOUT <span>FIXMYCITY</span>
        </h1>
        <p class="fmc-card-subtitle" style="max-width: 720px; font-size: 16px;">
            A next-generation municipal governance platform empowering residents to report infrastructure bottlenecks, track work orders in real-time, settle utility dues, and co-create cleaner, safer neighborhoods.
        </p>
    </div>

    <!-- Core Pillars Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-4 shadow-sm hover-shadow transition-all">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 52px; height: 52px; font-size: 24px;">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Precision Dispatch</h5>
                <p class="text-muted small mb-0">
                    Live GPS triangulation, OpenStreetMap coordinates, and photo evidence route reports directly to the assigned ward crew.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-4 shadow-sm hover-shadow transition-all">
                <div class="rounded-3 p-3 bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 52px; height: 52px; font-size: 24px;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="fw-bold mb-2">Accountability Radar</h5>
                <p class="text-muted small mb-0">
                    Every ticket maintains a cryptographically verified status trail from Submission to Under Review, In Progress, and Verified Resolution.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-4 shadow-sm hover-shadow transition-all">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 52px; height: 52px; font-size: 24px;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <h5 class="fw-bold mb-2">Digital Gateway</h5>
                <p class="text-muted small mb-0">
                    Zero-hassle bill payments for electricity, water, gas, and municipal holding tax via bKash, Nagad, Rocket, and card rails.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-4 shadow-sm hover-shadow transition-all">
                <div class="rounded-3 p-3 bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 52px; height: 52px; font-size: 24px;">
                    <i class="bi bi-broadcast"></i>
                </div>
                <h5 class="fw-bold mb-2">Emergency Safety</h5>
                <p class="text-muted small mb-0">
                    Hyperlocal public notices, citywide disaster directives, and a community lost-and-found recovery network.
                </p>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="card border rounded-3 shadow-sm p-4 p-md-5 mb-5">
        <h3 class="fw-bold mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-diagram-3-fill text-primary"></i> The Municipal Resolution Lifecycle
        </h3>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                        1
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Citizen Logs Incident</h6>
                        <p class="text-muted small mb-0">
                            Capture a photo of the hazard, verify GPS coordinates on Leaflet, and submit the report in seconds without paperwork.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                        2
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Department Triage & Dispatch</h6>
                        <p class="text-muted small mb-0">
                            Department managers review incoming tickets, deduplicate reports, assign field technicians, and schedule repair windows.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                        3
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Verified Resolution</h6>
                        <p class="text-muted small mb-0">
                            Technicians upload photographic resolution evidence. Citizens and supervisors confirm work completion before closure.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Supported Authorities / Coverage -->
    <div class="card border rounded-3 shadow-sm p-4 mb-5">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-buildings-fill text-primary"></i> Integrated Municipal Authorities & Utilities
        </h4>
        <p class="text-muted small mb-4">
            FixMyCity coordinates with multiple city corporations and regional utility providers across the capital:
        </p>

        <div class="row g-3">
            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-building text-primary fs-4"></i>
                    <div>
                        <div class="fw-bold small">City Corporation</div>
                        <div class="text-muted" style="font-size: 12px;">Roads, Drainage & Waste Management</div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                    <div>
                        <div class="fw-bold small">Power Regulators</div>
                        <div class="text-muted" style="font-size: 12px;">DPDC & DESCO Grid Outages</div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-droplet-fill text-info fs-4"></i>
                    <div>
                        <div class="fw-bold small">Water & Sewerage</div>
                        <div class="text-muted" style="font-size: 12px;">DWASA Pipeline Leaks & Contamination</div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-fire text-danger fs-4"></i>
                    <div>
                        <div class="fw-bold small">Gas Transmission</div>
                        <div class="text-muted" style="font-size: 12px;">Titas Gas Emergency Line Repairs</div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-cone-striped text-warning fs-4"></i>
                    <div>
                        <div class="fw-bold small">Traffic Control</div>
                        <div class="text-muted" style="font-size: 12px;">Signage, Signals & Road Blockades</div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <i class="bi bi-bank2 text-success fs-4"></i>
                    <div>
                        <div class="fw-bold small">Municipal Revenue</div>
                        <div class="text-muted" style="font-size: 12px;">Holding Tax Assessment & Clearance</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Banner -->
    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 text-center text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
        <h3 class="fw-bold mb-2">Ready to Make Your Neighborhood Better?</h3>
        <p class="text-white-50 mx-auto mb-4" style="max-width: 520px;">
            Join thousands of active citizens who report infrastructure hazards every week. Every verified submission creates measurable community impact.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Reports" asp-action="Create" class="btn btn-light text-primary fw-bold px-4 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Report an Issue
            </a>
            <a asp-controller="Map" asp-action="Index" class="btn btn-outline-light px-4 py-2">
                <i class="bi bi-pin-map me-1"></i> View Problem Map
            </a>
        </div>
    </div>
</div>
