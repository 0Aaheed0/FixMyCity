@model FixMyCity.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "User Profile & Security";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1080px;">

    <!-- Hero Header -->
    <div class="fmc-dashboard-hero mb-4">
        <span class="fmc-dashboard-kicker">
            <i class="bi bi-person-badge-fill"></i> ACCOUNT MANAGEMENT
        </span>
        <h1 class="fmc-card-title mb-1">CITIZEN <span>PROFILE</span></h1>
        <p class="fmc-card-subtitle">
            Manage your personal contact details, municipal role permissions, and account security credentials.
        </p>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["ProfileSuccess"]
        </div>
    }
    @if (TempData["ChangePasswordSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["ChangePasswordSuccess"]
        </div>
    }
    @if (TempData["ChangePasswordErrors"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ChangePasswordErrors"]
        </div>
    }

    <!-- Personal Information & Picture Form -->
    <div class="card border rounded-3 shadow-sm mb-4">
        <div class="card-header bg-transparent py-3 px-4 border-bottom">
            <h4 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-fill text-primary"></i> Personal Information
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Index" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- Left: Profile Picture Column -->
                    <div class="col-md-4 text-center border-end-md pb-3 pb-md-0">
                        <div class="mb-3">
                            @{ 
                                var imgUrl = Model.CurrentProfileImageFileName != null 
                                    ? Url.Content($"~/uploads/profile-pictures/{Model.CurrentProfileImageFileName}") 
                                    : Url.Content("~/images/default-profile.svg"); 
                            }
                            <img src="@imgUrl" alt="Profile" class="rounded-circle border border-3 border-primary shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" />
                        </div>
                        <div class="mb-2">
                            <label class="btn btn-sm btn-outline-primary cursor-pointer">
                                <i class="bi bi-camera me-1"></i> Change Picture
                                <input type="file" name="ProfileImage" accept="image/*" class="d-none" id="profileImageInput" />
                            </label>
                        </div>
                        <small class="text-muted d-block">JPG, PNG, WebP &bull; Max 2MB</small>

                        <div class="mt-4 pt-3 border-top text-center">
                            <span class="text-muted small d-block mb-1">System Role</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fs-6">
                                <i class="bi bi-shield-check me-1"></i> @Model.Role
                            </span>
                        </div>
                    </div>

                    <!-- Right: Form Fields Column -->
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" class="form-control bg-body-secondary text-muted" readonly />
                            <small class="text-muted">Primary identity email cannot be modified directly.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+880 1700-000000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-semibold">Residential / Ward Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Road, House, Ward/Area..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Account Security Section -->
    <div class="card border rounded-3 shadow-sm mb-4">
        <div class="card-header bg-transparent py-3 px-4 border-bottom">
            <h4 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning"></i> Account Security & Password
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="ChangePassword" method="post" style="max-width: 520px;">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Password <span class="text-danger">*</span></label>
                    <input name="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                    <input name="NewPassword" type="password" class="form-control" placeholder="Enter new password (min 6 characters)" required />
                    <small class="text-muted">Must contain uppercase, lowercase, digit, and symbol.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                    <input name="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" required />
                </div>

                <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                    <i class="bi bi-key-fill me-1"></i> Update Password
                </button>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('profileImageInput')?.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(ev) {
                    const img = document.querySelector('.rounded-circle.border-primary');
                    if (img) img.src = ev.target.result;
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
