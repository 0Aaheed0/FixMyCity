@model IEnumerable<FixMyCity.Data.Models.Announcement>
@{
    ViewData["Title"] = "Manage Announcements - Admin";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1240px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">MUNICIPAL <span>ANNOUNCEMENTS</span></h2>
            <p class="text-muted small mb-0">Publish targeted civic notices with Haversine 2KM geo-radius broadcast.</p>
        </div>
        <button class="btn btn-primary d-inline-flex align-items-center gap-2" data-bs-toggle="collapse" data-bs-target="#newAnnouncementBox">
            <i class="bi bi-plus-lg"></i> Create New Announcement
        </button>
    </div>

    <!-- Create Collapsible Form -->
    <div class="collapse mb-4" id="newAnnouncementBox">
        <div class="card border rounded-3 shadow-sm p-4">
            <h4 class="h5 fw-bold mb-3 text-primary"><i class="bi bi-megaphone-fill me-2"></i> Publish Geo-Targeted Notice</h4>
            <form asp-action="CreateAnnouncement" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input name="Title" class="form-control" placeholder="e.g. Scheduled Road Resurfacing on Mirpur Road" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select name="Category" class="form-select" required>
                            <option value="Road Closure">Road Closure</option>
                            <option value="Water Supply">Water Supply</option>
                            <option value="Electricity">Electricity</option>
                            <option value="Traffic">Traffic</option>
                            <option value="Waste Collection">Waste Collection</option>
                            <option value="Construction">Construction</option>
                            <option value="Public Service">Public Service</option>
                            <option value="Weather">Weather</option>
                            <option value="Event">Event</option>
                            <option value="General Information">General Information</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Priority <span class="text-danger">*</span></label>
                        <select name="Priority" class="form-select" required>
                            <option value="Normal">Normal</option>
                            <option value="Urgent">Urgent</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Target Coverage Radius (km) <span class="text-danger">*</span></label>
                        <input name="RadiusKm" id="radiusInput" type="number" step="0.5" value="2.0" class="form-control" required />
                        <small class="text-muted">Default: 2.0 KM. Citizens within this radius will be notified.</small>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Target Landmark / Neighborhood Name</label>
                        <input name="TargetLocationName" class="form-control" placeholder="e.g. Dhanmondi, Farmgate, Gulshan-2" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Start Date & Time</label>
                        <input name="StartDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Expiry Date & Time</label>
                        <input name="ExpiryDate" type="datetime-local" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <!-- Leaflet Location Picker with Radius Preview -->
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-semibold mb-0">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> Pick Center Location on Map (Leaflet Radius Preview)
                        </label>
                        <span class="badge bg-primary-subtle text-primary font-monospace">Default: Dhaka Center</span>
                    </div>
                    <div id="adminAnnounceMap" style="height: 280px; border-radius: 8px;" class="border mb-2"></div>
                    <div class="row g-2">
                        <div class="col-6">
                            <input name="Latitude" id="annLat" type="number" step="any" value="23.7806" class="form-control form-control-sm font-monospace" required />
                        </div>
                        <div class="col-6">
                            <input name="Longitude" id="annLng" type="number" step="any" value="90.4070" class="form-control form-control-sm font-monospace" required />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Detailed Description <span class="text-danger">*</span></label>
                        <textarea name="Description" rows="3" class="form-control" placeholder="Provide full details of the civic advisory..." required></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-broadcast me-1"></i> Broadcast Announcement
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#newAnnouncementBox">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Announcements Table -->
    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-3">Title & Category</th>
                        <th class="py-3">Priority</th>
                        <th class="py-3">Target Area & Radius</th>
                        <th class="py-3">Validity</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end px-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var isActive = a.Status == "Active" && a.ExpiryDate >= DateTime.UtcNow;
                        <tr>
                            <td class="px-3">
                                <div class="fw-bold">@a.Title</div>
                                <span class="badge bg-light text-dark border mt-1">@a.Category</span>
                            </td>
                            <td>
                                <span class="badge @(a.Priority == "Urgent" ? "bg-danger" : "bg-secondary")">
                                    @a.Priority
                                </span>
                            </td>
                            <td>
                                <div><i class="bi bi-geo-alt-fill text-danger me-1"></i> @(string.IsNullOrEmpty(a.TargetLocationName) ? "Coords: " + a.Latitude.ToString("F3") + ", " + a.Longitude.ToString("F3") : a.TargetLocationName)</div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    ~@a.RadiusKm.ToString("0.#") km radius
                                </span>
                            </td>
                            <td>
                                <div class="small text-muted">From: @a.StartDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <div class="small text-danger">Until: @a.ExpiryDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <span class="badge @(isActive ? "bg-success" : "bg-secondary") px-2 py-1">
                                    @(isActive ? "Active" : "Expired")
                                </span>
                            </td>
                            <td class="text-end px-3">
                                @if (isActive)
                                {
                                    <form asp-action="ExpireAnnouncement" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Expire this announcement immediately?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Expire Now
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map, marker, circle;

        document.addEventListener('DOMContentLoaded', function () {
            const initialLat = 23.7806;
            const initialLng = 90.4070;
            const radiusKm = parseFloat(document.getElementById('radiusInput').value) || 2.0;

            map = L.map('adminAnnounceMap').setView([initialLat, initialLng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);
            circle = L.circle([initialLat, initialLng], {
                color: '#3b82f6',
                fillColor: '#93c5fd',
                fillOpacity: 0.25,
                radius: radiusKm * 1000
            }).addTo(map);

            function updateCircle() {
                const pos = marker.getLatLng();
                const r = (parseFloat(document.getElementById('radiusInput').value) || 2.0) * 1000;
                circle.setLatLng(pos);
                circle.setRadius(r);
                document.getElementById('annLat').value = pos.lat.toFixed(6);
                document.getElementById('annLng').value = pos.lng.toFixed(6);
            }

            marker.on('drag', updateCircle);
            marker.on('dragend', updateCircle);

            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                updateCircle();
            });

            document.getElementById('radiusInput').addEventListener('input', updateCircle);

            // Re-render map when collapsible opens
            document.getElementById('newAnnouncementBox').addEventListener('shown.bs.collapse', function () {
                map.invalidateSize();
            });
        });
    </script>
}
