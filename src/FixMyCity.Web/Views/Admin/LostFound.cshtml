@model IEnumerable<FixMyCity.Data.Models.LostFoundPost>
@{
    ViewData["Title"] = "Lost & Found Moderation - Admin";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1200px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">LOST & FOUND <span>COMMUNITY MODERATION</span></h2>
            <p class="text-muted small mb-0">Monitor community listings, review citizen flags, and moderate inappropriate or resolved content.</p>
        </div>
    </div>

    <!-- Posts Table -->
    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-3">Item Details</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Posted By</th>
                        <th class="py-3">Location & Date</th>
                        <th class="py-3">Flag Reports</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end px-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        var isLost = post.PostType == "Lost";
                        <tr class="@(post.IsHidden ? "table-danger bg-opacity-25" : "")">
                            <td class="px-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(post.PhotoPath))
                                    {
                                        <img src="@post.PhotoPath" alt="Thumb" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    <div>
                                        <div class="fw-bold">@post.Title</div>
                                        <small class="badge bg-light text-dark border">@post.Category</small>
                                        @if (post.IsHidden)
                                        {
                                            <span class="badge bg-danger ms-1">HIDDEN FROM FEED</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(isLost ? "bg-danger" : "bg-success")">
                                    @post.PostType.ToUpper()
                                </span>
                            </td>
                            <td>
                                <div>@(post.User?.FullName ?? "Citizen")</div>
                                <small class="text-muted font-monospace">@post.User?.Email</small>
                            </td>
                            <td>
                                <div><i class="bi bi-geo-alt text-danger me-1"></i> @post.LocationName</div>
                                <small class="text-muted">@post.EventDate.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>
                                @if (post.ReportCount > 0)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">
                                        <i class="bi bi-flag-fill me-1"></i> @post.ReportCount Flag@(post.ReportCount > 1 ? "s" : "")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">0 flags</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(post.Status == "Resolved" ? "bg-success" : post.Status == "Active" ? "bg-primary" : "bg-secondary")">
                                    @post.Status
                                </span>
                            </td>
                            <td class="text-end px-3">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-controller="Community" asp-action="LostFoundDetails" asp-route-id="@post.Id" target="_blank" class="btn btn-sm btn-outline-primary" title="View details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <form asp-action="ToggleLostFoundHide" asp-route-id="@post.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(post.IsHidden ? "btn-outline-success" : "btn-outline-danger")" title="@(post.IsHidden ? "Unhide" : "Hide")">
                                            <i class="bi @(post.IsHidden ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
