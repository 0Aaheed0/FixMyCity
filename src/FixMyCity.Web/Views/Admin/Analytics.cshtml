@{
    ViewData["Title"] = "Hotspot Analytics";
    var byCategory = ViewBag.ByCategory as IEnumerable<dynamic>;
}
<div class="fmc-dashboard-hero">
    <h2>Hotspot Analytics</h2>
    <table class="table mt-3">
        <thead><tr><th>Category</th><th>Report Count</th></tr></thead>
        <tbody>
            @foreach (var row in byCategory!)
            {
                <tr><td>@row.Category</td><td>@row.Count</td></tr>
            }
        </tbody>
    </table>
</div>