@model IEnumerable<FixMyCity.Data.Models.EmergencyAlert>
@{
    ViewData["Title"] = "Emergency Alerts - Admin";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1200px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1 text-danger-emphasis">CITY-WIDE <span>EMERGENCY ALERTS</span></h2>
            <p class="text-muted small mb-0">Publish critical municipal directives that instantly notify all citizens without geographic boundaries.</p>
        </div>
        <button class="btn btn-danger d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="collapse" data-bs-target="#newAlertBox">
            <i class="bi bi-shield-exclamation"></i> Publish Emergency Alert
        </button>
    </div>

    <!-- Create Collapsible Form -->
    <div class="collapse mb-4" id="newAlertBox">
        <div class="card border-danger border-2 rounded-3 shadow-sm p-4 bg-danger-subtle bg-opacity-10">
            <h4 class="h5 fw-bold mb-3 text-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i> Issue New Emergency Directive</h4>
            <form asp-action="CreateEmergencyAlert" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Alert Headline <span class="text-danger">*</span></label>
                        <input name="Title" class="form-control form-control-lg" placeholder="e.g. Major Gas Pipeline Rupture - Evacuate Zone B" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Severity Level <span class="text-danger">*</span></label>
                        <select name="Severity" class="form-select" required>
                            <option value="Critical">Critical (Immediate Danger / Evacuation)</option>
                            <option value="High">High (Major Infrastructure / Safety Warning)</option>
                            <option value="Medium">Medium (Urgent Precautionary Advisory)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Effective Start Time</label>
                        <input name="StartAt" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Expiration / Auto-Clear Time</label>
                        <input name="ExpireAt" type="datetime-local" class="form-control" value="@DateTime.Now.AddDays(2).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Full Directive & Safety Instructions <span class="text-danger">*</span></label>
                        <textarea name="Description" rows="4" class="form-control" placeholder="Detailed instructions for citizens, helplines, evacuation routes..." required></textarea>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Important:</strong> Publishing this alert immediately creates urgent push notifications across all registered citizen accounts regardless of their GPS location.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                        <i class="bi bi-broadcast me-1"></i> Authorize & Broadcast Alert
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#newAlertBox">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-3">Headline</th>
                        <th class="py-3">Severity</th>
                        <th class="py-3">Scope</th>
                        <th class="py-3">Issued Date</th>
                        <th class="py-3">Expires</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end px-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model)
                    {
                        var isLive = alert.Status == "Active" && alert.ExpireAt >= DateTime.UtcNow;
                        <tr>
                            <td class="px-3">
                                <div class="fw-bold text-danger-emphasis">@alert.Title</div>
                            </td>
                            <td>
                                <span class="badge @(alert.Severity == "Critical" ? "bg-danger" : alert.Severity == "High" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @alert.Severity.ToUpper()
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-globe me-1"></i> City-wide (No Radius)
                                </span>
                            </td>
                            <td class="small">@alert.StartAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="small text-danger">@alert.ExpireAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(isLive ? "bg-success" : "bg-secondary")">
                                    @(isLive ? "Active / Broadcasting" : alert.Status)
                                </span>
                            </td>
                            <td class="text-end px-3">
                                @if (isLive)
                                {
                                    <form asp-action="CancelEmergencyAlert" asp-route-id="@alert.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this emergency alert?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Cancel Alert
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
