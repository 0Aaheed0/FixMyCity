@model IEnumerable<FixMyCity.Data.Models.MunicipalProvider>
@{
    ViewData["Title"] = "Municipal Providers - Admin";
    Layout = "_LayoutApp";
    var services = ViewBag.Services as IEnumerable<FixMyCity.Data.Models.MunicipalService> ?? Enumerable.Empty<FixMyCity.Data.Models.MunicipalService>();
}

<div class="container-fluid py-4" style="max-width: 1100px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> BACK TO ADMIN DASHBOARD
        </a>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">MUNICIPAL <span>SERVICE PROVIDERS</span></h2>
            <p class="text-muted small mb-0">Manage utility authorities and city corporation billing entities.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MunicipalServices" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Services
            </a>
            <button class="btn btn-primary d-inline-flex align-items-center gap-2" data-bs-toggle="collapse" data-bs-target="#newProviderBox">
                <i class="bi bi-plus-lg"></i> Add New Provider
            </button>
        </div>
    </div>

    <!-- Create Collapsible Form -->
    <div class="collapse mb-4" id="newProviderBox">
        <div class="card border rounded-3 shadow-sm p-4">
            <h4 class="h5 fw-bold mb-3 text-primary"><i class="bi bi-building-add me-2"></i> Register New Utility Provider</h4>
            <form asp-action="CreateProvider" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Provider Name <span class="text-danger">*</span></label>
                        <input name="Name" class="form-control" placeholder="e.g. DPDC, DESCO, Titas Gas, Dhaka WASA" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Service Category <span class="text-danger">*</span></label>
                        <select name="ServiceId" class="form-select" required>
                            <option value="">-- Assign to Service --</option>
                            @foreach (var s in services)
                            {
                                <option value="@s.Id">@s.Name (@s.Category)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Account / Consumer Label <span class="text-danger">*</span></label>
                        <input name="AccountNumberLabel" class="form-control" placeholder="e.g. Consumer Number, Meter No, Holding Number" required />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Register Provider</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#newProviderBox">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Providers Table -->
    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-3">Provider Name</th>
                        <th class="py-3">Associated Service</th>
                        <th class="py-3">Account Number Prompt</th>
                        <th class="py-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="px-3">
                                <div class="fw-bold">@p.Name</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-tag-fill me-1 text-primary"></i> @p.Service?.Name (@p.Service?.Category)
                                </span>
                            </td>
                            <td>
                                <code>@p.AccountNumberLabel</code>
                            </td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                    @(p.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
