@model IEnumerable<FixMyCity.Data.Models.PaymentTransaction>
@{
    ViewData["Title"] = "Transactions - Admin";
    Layout = "_LayoutApp";
    var totalSuccess = ViewBag.TotalSuccessful as int? ?? 0;
    var totalFailed = ViewBag.TotalFailed as int? ?? 0;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<div class="container-fluid py-4" style="max-width: 1240px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> BACK TO ADMIN DASHBOARD
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">MUNICIPAL <span>TRANSACTION AUDIT</span></h2>
            <p class="text-muted small mb-0">Complete audit trail of citizen digital payments and utility revenue collections.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle p-2 fs-6">
                <i class="bi bi-check-circle me-1"></i> @totalSuccess Successful
            </span>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2 fs-6">
                <i class="bi bi-x-circle me-1"></i> @totalFailed Failed
            </span>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Transactions" asp-route-status="" class="btn btn-sm @(string.IsNullOrEmpty(selectedStatus) || selectedStatus == "All" ? "btn-primary" : "btn-outline-secondary")">
            All Transactions
        </a>
        <a asp-action="Transactions" asp-route-status="Success" class="btn btn-sm @(selectedStatus == "Success" ? "btn-success" : "btn-outline-success")">
            Successful Only
        </a>
        <a asp-action="Transactions" asp-route-status="Failed" class="btn btn-sm @(selectedStatus == "Failed" ? "btn-danger" : "btn-outline-danger")">
            Failed Only
        </a>
    </div>

    <!-- Transactions Table -->
    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-3">Transaction Ref</th>
                        <th class="py-3">Citizen Payer</th>
                        <th class="py-3">Provider</th>
                        <th class="py-3">Consumer No</th>
                        <th class="py-3">Payment Channel</th>
                        <th class="py-3 text-end">Amount</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-end px-3">Receipt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var txn in Model)
                    {
                        <tr>
                            <td class="px-3">
                                <span class="font-monospace fw-semibold text-primary">@txn.TransactionReference</span>
                                <div class="text-muted small" style="font-size: 11px;">
                                    @((txn.PaidAt ?? txn.CreatedAt).ToLocalTime().ToString("MMM dd, yyyy HH:mm"))
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@(txn.User?.FullName ?? "Citizen")</div>
                                <small class="text-muted font-monospace">@txn.User?.Email</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @txn.Bill?.Provider?.Name
                                </span>
                            </td>
                            <td class="font-monospace">@txn.Bill?.ConsumerNumber</td>
                            <td>
                                <span class="badge bg-light text-dark border">@txn.PaymentMethod</span>
                            </td>
                            <td class="text-end fw-bold font-monospace">
                                BDT @txn.Amount.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge @(txn.Status == "Success" ? "bg-success" : "bg-danger") px-2 py-1">
                                    @txn.Status
                                </span>
                            </td>
                            <td class="text-end px-3">
                                <a asp-controller="Gateway" asp-action="Receipt" asp-route-transactionId="@txn.Id" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-file-earmark-text"></i> Receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
