@model IEnumerable<FixMyCity.Data.Models.Report>
@{
    ViewData["Title"] = "Review Reports";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1240px;">

    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    @if (TempData["AdminMessage"] is string message)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @message
        </div>
    }

    <div class="fmc-dashboard-hero mb-4">
        <span class="fmc-dashboard-kicker">
            <i class="bi bi-shield-check"></i> ADMIN MODERATION
        </span>
        <h1 class="fmc-card-title mb-1">CIVIC <span>REPORT TRIAGE</span></h1>
        <p class="fmc-card-subtitle">
            Validate community submissions and move issues through the official municipal resolution workflow.
        </p>
    </div>

    <div class="card border rounded-3 shadow-sm overflow-hidden">
        <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">All Reported Incidents</h5>
            <span class="badge bg-body-secondary text-body border">@Model.Count() Submissions</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Report Details</th>
                        <th>Category</th>
                        <th>Resident</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Update Workflow Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        var status = report.Issue?.Status ?? "Reported";
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-body">#@report.Id</div>
                                <div class="text-body-secondary small" style="max-width: 380px;">@report.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-body-secondary text-body border">
                                    @(report.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">@(report.User?.Email ?? "Anonymous")</small>
                            </td>
                            <td>
                                @if (status == "Verified")
                                {
                                    <span class="badge badge-verified">Verified</span>
                                }
                                else if (status == "Resolved")
                                {
                                    <span class="badge badge-resolved">Resolved</span>
                                }
                                else if (status == "InProgress")
                                {
                                    <span class="badge badge-in-progress">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge badge-reported">Reported</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <form asp-action="UpdateReportStatus" method="post" class="d-inline-flex align-items-center justify-content-end gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reportId" value="@report.Id" />
                                    <select name="status" class="form-select form-select-sm" style="width: auto;">
                                        <option value="Reported" selected="@(status == "Reported")">Reported</option>
                                        <option value="InProgress" selected="@(status == "InProgress")">In Progress</option>
                                        <option value="Resolved" selected="@(status == "Resolved")">Resolved</option>
                                        <option value="Verified" selected="@(status == "Verified")">Verified</option>
                                    </select>
                                    <button class="btn btn-sm btn-primary" type="submit">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
