@model IEnumerable<FixMyCity.Data.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_LayoutApp";
    var depts = ViewBag.Departments as List<FixMyCity.Data.Models.Department> ?? new List<FixMyCity.Data.Models.Department>();
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    <!-- Hero Header -->
    <div class="fmc-dashboard-hero mb-4">
        <span class="fmc-dashboard-kicker">
            <i class="bi bi-tags-fill"></i> INCIDENT CLASSIFICATION
        </span>
        <h1 class="fmc-card-title mb-1">CIVIC ISSUE <span>CATEGORIES</span></h1>
        <p class="fmc-card-subtitle">
            Define incident categories and map them to responsible municipal departments for automated routing.
        </p>
    </div>

    <div class="row g-4">
        <!-- Add Category Form Card -->
        <div class="col-lg-4">
            <div class="card border rounded-3 shadow-sm p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill text-primary"></i> Create Category
                </h5>
                <form asp-action="Categories" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">Category Title <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Broken Water Pipe" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Responsible Department <span class="text-danger">*</span></label>
                        <select name="DepartmentId" class="form-select" required>
                            <option value="">-- Select Department --</option>
                            @foreach (var dep in depts)
                            {
                                <option value="@dep.Id">@dep.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg me-1"></i> Add Category
                    </button>
                </form>
            </div>
        </div>

        <!-- Categories List Table Card -->
        <div class="col-lg-8">
            <div class="card border rounded-3 shadow-sm overflow-hidden">
                <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Active Issue Categories</h5>
                    <span class="badge bg-body-secondary text-body border">@Model.Count() Categories</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Category Name</th>
                                <th>Responsible Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-body">
                                            <i class="bi bi-tag-fill me-1 text-primary"></i> @c.Name
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-body-secondary text-body border">
                                            @(c.Department?.Name ?? c.ResponsibleDepartment ?? "Unassigned")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>