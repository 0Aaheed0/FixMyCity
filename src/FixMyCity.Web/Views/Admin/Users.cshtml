@model IEnumerable<FixMyCity.Data.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}
<div class="fmc-dashboard-hero">
    <h2>Manage Users</h2>
    <table class="table mt-3">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr><td>@u.FullName</td><td>@u.Email</td><td>@u.Role</td></tr>
            }
        </tbody>
    </table>
</div>