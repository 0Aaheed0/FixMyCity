@model IEnumerable<FixMyCity.Data.Models.Department>
@{
    ViewData["Title"] = "Manage Departments";
    Layout = "_LayoutApp";
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
    </div>

    <!-- Hero Header -->
    <div class="fmc-dashboard-hero mb-4">
        <span class="fmc-dashboard-kicker">
            <i class="bi bi-diagram-3-fill"></i> MUNICIPAL INFRASTRUCTURE
        </span>
        <h1 class="fmc-card-title mb-1">DEPARTMENT <span>MANAGEMENT</span></h1>
        <p class="fmc-card-subtitle">
            Configure municipal departments, operational jurisdictions, and team descriptions.
        </p>
    </div>

    <div class="row g-4">
        <!-- Add Department Form Card -->
        <div class="col-lg-4">
            <div class="card border rounded-3 shadow-sm p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill text-primary"></i> Create Department
                </h5>
                <form asp-action="Departments" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">Department Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Waste Management" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Jurisdiction details..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg me-1"></i> Add Department
                    </button>
                </form>
            </div>
        </div>

        <!-- Departments List Table Card -->
        <div class="col-lg-8">
            <div class="card border rounded-3 shadow-sm overflow-hidden">
                <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Active Municipal Departments</h5>
                    <span class="badge bg-body-secondary text-body border">@Model.Count() Departments</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Department Name</th>
                                <th>Description / Scope</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-body">
                                            <i class="bi bi-building me-1 text-primary"></i> @d.Name
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(d.Description) ? "No description provided" : d.Description)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>