@model IEnumerable<FixMyCity.Data.Models.EmergencyAlert>
@{
    ViewData["Title"] = "Emergency Alerts";
    Layout = User.Identity?.IsAuthenticated == true ? "_LayoutApp" : "_Layout";
    var pastAlerts = ViewBag.PastAlerts as IEnumerable<FixMyCity.Data.Models.EmergencyAlert> ?? Enumerable.Empty<FixMyCity.Data.Models.EmergencyAlert>();
}

<div class="container py-4" style="max-width: 1000px;">
    <!-- Hero / Header -->
    <div class="fmc-dashboard-hero mb-4 border-danger">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-danger px-3 py-1 font-monospace" style="font-size: 11px; letter-spacing: 2px;">
                <i class="bi bi-shield-exclamation me-1"></i> CITY-WIDE DIRECTIVE
            </span>
        </div>
        <h1 class="fmc-card-title mb-1 text-danger-emphasis">
            EMERGENCY <span>ALERTS & DIRECTIVES</span>
        </h1>
        <p class="fmc-card-subtitle">
            Critical public safety emergencies broadcasted to all citizens across metropolitan Dhaka and regional jurisdictions without boundary limits.
        </p>
    </div>

    <!-- Active Alerts Section -->
    <div class="mb-5">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2 text-danger">
            <i class="bi bi-exclamation-octagon-fill"></i> Active Emergency Bulletins
        </h4>

        @if (!Model.Any())
        {
            <div class="card border-success border-dashed rounded-3 p-4 text-center bg-success-subtle bg-opacity-10">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 40px;"></i>
                <h5 class="fw-bold text-success mt-2 mb-1">No Active Emergency Situations</h5>
                <p class="text-muted small mb-0">City emergency services are running normally with no high-severity citywide alerts declared.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var alert in Model)
                {
                    var isCritical = alert.Severity == "Critical";
                    <div class="card border-2 @(isCritical ? "border-danger bg-danger-subtle bg-opacity-10" : "border-warning bg-warning-subtle bg-opacity-10") rounded-3 shadow-sm p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-circle @(isCritical ? "bg-danger text-white" : "bg-warning text-dark") p-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px; font-size: 26px;">
                                    <i class="bi @(isCritical ? "bi-exclamation-triangle-fill" : "bi-bell-fill")"></i>
                                </div>
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="badge @(isCritical ? "bg-danger" : "bg-warning text-dark") fs-6 px-3 py-1">
                                            @alert.Severity.ToUpper() SEVERITY
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-broadcast me-1"></i> GLOBAL BROADCAST
                                        </span>
                                        <span class="text-muted small">
                                            Issued: @alert.StartAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    </div>

                                    <h3 class="fw-bold text-danger-emphasis mb-1">@alert.Title</h3>

                                    <p class="fs-6 mb-3 text-body" style="line-height: 1.6; max-width: 780px;">
                                        @alert.Description
                                    </p>

                                    <div class="d-flex align-items-center gap-3 text-muted small">
                                        <span><i class="bi bi-hourglass-bottom me-1 text-danger"></i> Valid Until: <strong>@alert.ExpireAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</strong></span>
                                        <span><i class="bi bi-shield-check me-1"></i> Authorized Command</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Past Alerts History -->
    <div>
        <h5 class="fw-semibold text-muted mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i> Past Expired Alerts & Incident Archive
        </h5>

        @if (!pastAlerts.Any())
        {
            <p class="text-muted small">No past emergency archives on record.</p>
        }
        else
        {
            <div class="list-group shadow-sm border rounded-3">
                @foreach (var alert in pastAlerts)
                {
                    <div class="list-group-item p-3 border-bottom d-flex justify-content-between align-items-center opacity-75">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">EXPIRED</span>
                                <span class="fw-bold">@alert.Title</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Issued: @alert.StartAt.ToLocalTime().ToString("MMM dd, yyyy") &bull; Expired: @alert.ExpireAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <span class="badge bg-light text-secondary border">@alert.Severity</span>
                    </div>
                }
            </div>
        }
    </div>
</div>
