@model IEnumerable<FixMyCity.Data.Models.Assignment>
@{
    ViewData["Title"] = "Manager Dashboard";
}
<div class="fmc-dashboard-hero">
    <h2>Manager Dashboard</h2>
    @if (!Model.Any())
    {
        <p>No assignments yet.</p>
    }
    else
    {
        <table class="table mt-3">
            <thead><tr><th>Department</th><th>Staff</th><th>Status</th><th>Assigned</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Department?.Name</td>
                        <td>@a.AssignedStaff?.FullName</td>
                        <td>@a.Status</td>
                        <td>@a.AssignedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<div class="fmc-app-card p-4 mt-4"><h4>Assign an issue</h4><form asp-action="Assign" method="post" class="row g-3"><div class="col-md-3"><select name="issueId" class="form-select" required><option value="">Issue</option>@foreach (var i in (IEnumerable<FixMyCity.Data.Models.Issue>)ViewBag.Issues) { <option value="@i.Id">#@i.Id - @i.Category?.Name</option> }</select></div><div class="col-md-3"><select name="departmentId" class="form-select" required><option value="">Department</option>@foreach (var d in (IEnumerable<FixMyCity.Data.Models.Department>)ViewBag.Departments) { <option value="@d.Id">@d.Name</option> }</select></div><div class="col-md-3"><select name="assignedStaffUserId" class="form-select"><option value="">Assign staff</option>@foreach (var s in (IEnumerable<FixMyCity.Data.Models.ApplicationUser>)ViewBag.Staff) { <option value="@s.Id">@s.FullName</option> }</select></div><div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Assign issue</button></div></form></div>
