@page
@model LogoutModel
@{
    ViewData["Title"] = "Signed Out";
    Layout = "_LayoutAuth";
}

<div class="fmc-auth-header text-center">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success p-3 mb-3" style="width: 64px; height: 64px; font-size: 30px;">
        <i class="bi bi-shield-check"></i>
    </div>
    <div class="fmc-auth-badge mb-2">SESSION TERMINATED</div>
    <h1 class="fmc-auth-title">Signed Out Securely</h1>
    <p class="fmc-auth-subtitle">
        You have safely disconnected from FixMyCity Smart Municipal Portal.
    </p>
</div>

<div class="d-grid gap-2 mt-4">
    <a asp-page="./Login" class="btn btn-primary py-2 fw-bold">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In Again
    </a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary py-2">
        <i class="bi bi-house me-1"></i> Return to Public Portal
    </a>
</div>
